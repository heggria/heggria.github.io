---
import type { CollectionEntry } from 'astro:content'
import { formatDate, postLink, readingMinutes } from '../lib/posts'
interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props
---
<a class="post-row" href={postLink(post)}>
  <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
  <div><h3>{post.data.title}</h3>{post.data.description && <p>{post.data.description}</p>}</div>
  <span class="post-read-time">约 {readingMinutes(post.body)} 分钟 <span aria-hidden="true">↗</span></span>
</a>
