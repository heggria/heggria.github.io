---
import { createBaseline, nodes, statusLabels } from '../lib/flow-lab'
interface Props { compact?: boolean; id?: string }
const { compact = false, id = 'flow-lab' } = Astro.props
const baseline = createBaseline()
const selected = nodes[0]!
---

<section id={id} class:list={['flow-lab', { compact }]} data-flow-lab data-pagefind-ignore aria-labelledby={`${id}-title`}>
  <header class="lab-header">
    <div>
      <p class="eyebrow"><span aria-hidden="true">◉</span> 本地教学模型 <span class="separator" aria-hidden="true">/</span> 不调用模型</p>
      <h2 id={`${id}-title`}>增量重算<span class="title-note" lang="en">Recompute</span></h2>
    </div>
    <span class="lab-index" aria-hidden="true">LAB / 01</span>
  </header>
  <p class="intro">改一次摘要，看看哪些步骤重做，哪些结果保留。</p>
  <div class="controls" role="group" aria-label="选择重算情景">
    <button type="button" class="scenario" data-scenario="changed" aria-pressed="false">摘要改了 <span aria-hidden="true">↗</span></button>
    <button type="button" class="scenario" data-scenario="unchanged" aria-pressed="false">结果没变 <span aria-hidden="true">↳</span></button>
    <button type="button" class="reset" data-reset>重置基线 <span aria-hidden="true">↺</span></button>
  </div>
  <div class="readout" aria-label="示例节点状态计数">
    <span class="readout-label">示例节点 / 5</span>
    <span>已完成 <b data-total="completed">5</b></span>
    <span class="count-rerun">重算 <b data-total="rerun">0</b></span>
    <span>复用 <b data-total="reused">0</b></span>
    <span class="count-cutoff">截断 <b data-total="cutoff">0</b></span>
  </div>
  <div class="graph" role="group" aria-label="计算依赖图，选择节点查看原因">
    <svg class="edges" viewBox="0 0 1000 350" preserveAspectRatio="none" aria-hidden="true" focusable="false">
      <defs><marker id={`${id}-arrow`} markerWidth="7" markerHeight="7" refX="6" refY="3.5" orient="auto"><path d="M 0 0 L 7 3.5 L 0 7" /></marker></defs>
      <g marker-end={`url(#${id}-arrow)`}>
        <path data-edge-from="source" data-edge-to="draft" d="M200 175 C240 175 240 85 273 85" />
        <path data-edge-from="source" data-edge-to="links" d="M200 175 C240 175 240 265 273 265" />
        <path data-edge-from="draft" data-edge-to="review" d="M460 85 L533 85" />
        <path data-edge-from="review" data-edge-to="report" d="M720 85 C760 85 760 175 793 175" />
        <path data-edge-from="links" data-edge-to="report" d="M460 265 L720 265 C760 265 760 175 793 175" />
      </g>
    </svg>
    {nodes.map((node) => (
      <button type="button" class={`node node-${node.id}`} data-node={node.id} data-status="completed"
        aria-pressed={node.id === selected.id ? 'true' : 'false'} aria-controls={`${id}-detail`}>
        <span class="node-number" aria-hidden="true">{node.number}</span>
        <span class="node-name">{node.label}</span>
        <span class="node-status"><i aria-hidden="true"></i><span data-node-status>{statusLabels.completed}</span></span>
      </button>
    ))}
  </div>
  <div id={`${id}-detail`} class="detail" aria-live="polite" aria-atomic="true">
    <p class="scenario-explanation" data-explanation>{baseline.explanation}</p>
    <div class="detail-heading"><span class="detail-label">选中节点</span><h3 data-detail-title>{selected.number} · {selected.label}</h3><span class="detail-status" data-detail-status>{statusLabels.completed}</span></div>
    <p class="detail-reason" data-detail-reason>{baseline.nodes[selected.id].reason}</p>
    <p class="output"><span>当前输出</span><span data-detail-output>{baseline.nodes[selected.id].output}</span></p>
  </div>
  <footer class="lab-footer"><span>高亮连线：变化传播 · 虚线：提前截断</span><span>点击节点查看原因</span></footer>
  <noscript><p class="no-script">当前显示已完成的基线。启用 JavaScript 后，可切换重算情景和查看每个节点的原因。</p></noscript>
</section>

<script>
  import { createBaseline, nodes, runScenario, statusLabels } from '../lib/flow-lab'
  import type { NodeId, Scenario } from '../lib/flow-lab'

  function initializeFlowLabs() {
    document.querySelectorAll<HTMLElement>('[data-flow-lab]').forEach((root) => {
      if (root.dataset.initialized) return
      root.dataset.initialized = 'true'
      let state = createBaseline()
      let selected: NodeId = 'source'
      const setText = (selector: string, text: string) => {
        const element = root.querySelector(selector)
        if (element) element.textContent = text
      }
      function render() {
        root.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.scenario === state.scenario))
        })
        for (const node of nodes) {
          const value = state.nodes[node.id]
          const button = root.querySelector<HTMLButtonElement>(`[data-node="${node.id}"]`)
          if (button) {
            button.dataset.status = value.status
            button.setAttribute('aria-pressed', String(node.id === selected))
            const status = button.querySelector('[data-node-status]')
            if (status) status.textContent = statusLabels[value.status]
          }
        }
        root.querySelectorAll<SVGPathElement>('[data-edge-to]').forEach((edge) => {
          const target = edge.dataset.edgeTo as NodeId
          const source = state.nodes[edge.dataset.edgeFrom as NodeId]
          edge.dataset.status = state.nodes[target].status === 'cutoff' && (source.status === 'rerun' || source.status === 'cutoff') ? 'cutoff'
            : source.status === 'rerun' && source.outputChanged ? 'rerun' : 'reused'
        })
        for (const status of ['completed', 'rerun', 'reused', 'cutoff'] as const) {
          setText(`[data-total="${status}"]`, String(state.totals[status]))
        }
        const definition = nodes.find((node) => node.id === selected)!
        const value = state.nodes[selected]
        setText('[data-explanation]', state.explanation)
        setText('[data-detail-title]', `${definition.number} · ${definition.label}`)
        setText('[data-detail-status]', statusLabels[value.status])
        setText('[data-detail-reason]', value.reason)
        setText('[data-detail-output]', value.output)
      }
      root.querySelectorAll<HTMLButtonElement>('[data-scenario]').forEach((button) => {
        button.addEventListener('click', () => {
          const scenario = button.dataset.scenario
          if (scenario !== 'changed' && scenario !== 'unchanged') return
          state = runScenario(scenario as Scenario)
          selected = 'draft'
          render()
        })
      })
      root.querySelector('[data-reset]')?.addEventListener('click', () => {
        state = createBaseline()
        selected = 'source'
        render()
      })
      root.querySelectorAll<HTMLButtonElement>('[data-node]').forEach((button) => {
        button.addEventListener('click', () => {
          const definition = nodes.find((node) => node.id === button.dataset.node)
          if (!definition) return
          selected = definition.id
          render()
        })
      })
    })
  }
  initializeFlowLabs()
  document.addEventListener('astro:page-load', initializeFlowLabs)
</script>

<style>
  .flow-lab {
    --surface: var(--lab-bg, #141714);
    --line: var(--lab-line, #343b33);
    --muted: var(--lab-muted, #a8b0a4);
    --text: var(--lab-text, #f4f6ee);
    --accent: var(--signal, #d2ff5a);
    box-sizing: border-box; isolation: isolate; color-scheme: dark;
    container: flow-lab / inline-size;
    background: var(--surface); color: var(--text); border: 1px solid var(--line);
    border-radius: 20px; padding: clamp(20px, 4vw, 40px); overflow: hidden;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
    font-size: 16px; line-height: 1.6;
  }
  .flow-lab * { box-sizing: border-box; }
  .flow-lab p, .flow-lab h2, .flow-lab h3 { margin: 0; }
  .lab-header { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; }
  .eyebrow { font-size: 12px; letter-spacing: .07em; color: var(--muted); }
  .eyebrow > span:first-child { color: var(--accent); margin-right: 6px; }
  .separator { padding: 0 6px; }
  .flow-lab h2 { font-size: clamp(26px, 3vw, 36px); font-weight: 650; letter-spacing: -.03em; margin-top: 8px; line-height: 1.3; }
  .title-note { display: inline-block; color: var(--muted); font: 12px ui-monospace, monospace; letter-spacing: 0; margin-left: 14px; vertical-align: middle; }
  .lab-index { font: 11px ui-monospace, monospace; color: var(--muted); padding-top: 5px; white-space: nowrap; }
  .flow-lab .intro { color: var(--muted); margin: 14px 0 22px; max-width: 50ch; font-size: 15px; }
  .controls { display: flex; flex-wrap: wrap; gap: 10px; }
  .flow-lab button { font: inherit; cursor: pointer; touch-action: manipulation; }
  .controls button { min-height: 46px; border: 1px solid var(--line); border-radius: 8px; padding: 10px 16px; color: var(--text); background: var(--surface); font-size: 14px; font-weight: 600; }
  .controls button span { padding-left: 14px; color: var(--accent); }
  .controls .scenario:hover { border-color: var(--accent); }
  .controls .scenario[aria-pressed='true'] { background: var(--accent); color: #141714; border-color: var(--accent); }
  .controls .scenario[aria-pressed='true'] span { color: #141714; }
  .controls .reset { margin-left: auto; color: var(--muted); }
  .flow-lab button:focus-visible { outline: 3px solid var(--accent); outline-offset: 4px; }
  .readout { margin-top: 24px; padding: 14px 0; border-block: 1px solid var(--line); display: flex; flex-wrap: wrap; gap: 8px 22px; color: var(--muted); font-size: 12px; }
  .readout-label { margin-right: auto; font-family: ui-monospace, monospace; }
  .readout b { font: 600 15px ui-monospace, monospace; padding-left: 5px; color: var(--text); }
  .count-rerun b, .count-cutoff b { color: var(--accent); }
  .graph { position: relative; height: 330px; margin: 14px 0; background-image: radial-gradient(var(--line) .7px, transparent .7px); background-size: 18px 18px; }
  .edges { position: absolute; width: 100%; height: 100%; inset: 0; overflow: visible; }
  .edges g > path { fill: none; stroke: var(--line); stroke-width: 1.6; vector-effect: non-scaling-stroke; }
  .edges marker path { fill: var(--muted); }
  .edges g > path[data-status='rerun'] { stroke: var(--accent); }
  .edges g > path[data-status='cutoff'] { stroke: var(--accent); stroke-dasharray: 5 5; }
  .node { position: absolute; transform: translate(-50%, -50%); width: 18%; min-height: 104px; text-align: left; border: 1px solid var(--line); border-radius: 10px; padding: 12px; background: var(--surface); color: var(--text); transition: border-color 160ms ease, background-color 160ms ease; }
  .node-source { left: 11%; top: 50%; }
  .node-draft { left: 37%; top: 24.2857%; }
  .node-links { left: 37%; top: 75.7143%; }
  .node-review { left: 63%; top: 24.2857%; }
  .node-report { left: 89%; top: 50%; }
  .node-number { display: block; color: var(--muted); font: 11px ui-monospace, monospace; }
  .node-name { display: block; font-size: 16px; font-weight: 600; margin: 5px 0 8px; white-space: nowrap; }
  .node-status { display: flex; gap: 6px; align-items: center; font-size: 11px; color: var(--muted); white-space: nowrap; }
  .node-status i { width: 6px; height: 6px; border-radius: 50%; background: currentColor; }
  .node[aria-pressed='true'] { box-shadow: 0 0 0 2px var(--text); }
  .node:hover { border-color: var(--text); }
  .node[data-status='rerun'] { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 8%, var(--surface)); }
  .node[data-status='rerun'] .node-status, .node[data-status='cutoff'] .node-status { color: var(--accent); }
  .node[data-status='cutoff'] { border-color: var(--accent); border-style: dashed; }
  .node[data-status='cutoff'] .node-status i { border-radius: 0; background: transparent; border: 1px solid currentColor; width: 7px; height: 7px; }
  .detail { border-top: 1px solid var(--line); padding-top: 20px; }
  .scenario-explanation { font-size: 14px; color: var(--muted); min-height: 3.2em; }
  .detail-heading { display: flex; align-items: center; flex-wrap: wrap; gap: 8px 12px; margin-top: 16px; }
  .detail-label { font-size: 11px; color: var(--muted); }
  .flow-lab h3 { font-size: 16px; font-weight: 600; }
  .detail-status { margin-left: auto; color: var(--accent); font-size: 12px; }
  .flow-lab .detail-reason { margin-top: 10px; font-size: 14px; min-height: 3.2em; }
  .flow-lab .output { display: grid; grid-template-columns: auto 1fr; gap: 12px; color: var(--muted); font-size: 12px; margin-top: 12px; padding: 12px 14px; border-left: 2px solid var(--line); background: #ffffff04; }
  .output > span:first-child { white-space: nowrap; }
  .output > span:last-child { white-space: pre-line; overflow-wrap: anywhere; }
  .lab-footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 16px; color: var(--muted); font-size: 11px; margin-top: 22px; }
  .no-script { margin-top: 16px !important; color: var(--muted); font-size: 14px; }
  .compact { padding: clamp(20px, 3vw, 28px); }
  .compact .graph { height: 290px; }
  .compact .output { display: none; }
  .compact .lab-footer { margin-top: 14px; }
  @container flow-lab (max-width: 760px) {
    .graph, .compact .graph { height: auto; display: grid; grid-template-columns: 1fr; gap: 12px; padding: 16px 0; background: none; }
    .edges { display: none; }
    .node { position: relative; inset: auto; transform: none; width: 100%; min-height: 68px; display: grid; grid-template-columns: 28px 1fr auto; align-items: center; gap: 8px; padding: 14px; }
    .node-name { margin: 0; font-size: 16px; }
    .node-status { font-size: 12px; }
    .node::after { display: block; grid-column: 2 / -1; color: var(--muted); font-size: 11px; font-weight: 400; }
    .node-source::after { content: '起点 · 供摘要与链接分支使用'; }
    .node-draft::after { content: '依赖 01 读取资料'; }
    .node-links::after { content: '依赖 01 读取资料 · 独立分支'; }
    .node-review::after { content: '依赖 02 生成摘要'; }
    .node-report::after { content: '依赖 04 审查摘要 + 03 检查链接'; }
    .readout-label { flex-basis: 100%; }
    .readout { column-gap: 16px; }
    .lab-index { display: none; }
    .controls .reset { margin-left: 0; }
    .scenario-explanation, .flow-lab .detail-reason { min-height: 0; }
    .flow-lab .output { grid-template-columns: 1fr; gap: 4px; }
  }
  @container flow-lab (max-width: 380px) {
    .title-note { display: block; margin: 8px 0 0; }
    .controls { gap: 8px; }
    .controls button { padding: 10px 12px; }
    .controls button span { padding-left: 6px; }
    .node { grid-template-columns: 22px 1fr; gap: 6px; }
    .node-status { grid-column: 2; }
    .detail-status { margin-left: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    .node { transition: none; }
  }
</style>
