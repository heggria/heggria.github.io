---
import '../styles/global.css'
interface Props { title?: string; description?: string; canonical?: string; type?: 'website' | 'article' }
const { title = 'Heggria — 工具、实验与写作', description = 'Heggria 的开源工具、界面实验与技术写作。在上海的 OpenDesign 做开发，维护 taskflow。', canonical = new URL(Astro.url.pathname, Astro.site).href, type = 'website' } = Astro.props
const path = Astro.url.pathname
---
<!doctype html>
<html lang="zh-CN" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f5f0" />
    <meta name="description" content={description} />
    <meta property="og:type" content={type} /><meta property="og:title" content={title} />
    <meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Heggria" /><meta property="og:image" content="https://heggria.github.io/avatar.jpg" />
    <meta property="og:image:alt" content="Heggria 的头像" /><meta name="twitter:card" content="summary" />
    <link rel="canonical" href={canonical} /><link rel="icon" href="/avatar.jpg" type="image/jpeg" />
    <link rel="alternate" type="application/rss+xml" title="Heggria 的文章" href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      (() => { let saved; try { saved = localStorage.getItem('theme') } catch {} const dark = saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches); document.documentElement.dataset.theme = dark ? 'dark' : 'light' })()
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">跳到正文</a>
    <header class="site-header" data-pagefind-ignore>
      <a class="wordmark" href="/" aria-label="Heggria 首页"><span class="wordmark-symbol" aria-hidden="true">h<span>·</span></span><span class="wordmark-name">HEGGRIA</span></a>
      <nav aria-label="主导航">
        <a href="/work/" aria-current={path.startsWith('/work') ? 'page' : undefined}>项目</a>
        <a href="/lab/" aria-current={path.startsWith('/lab') ? 'page' : undefined}>实验</a>
        <a href="/writing/" aria-current={path.startsWith('/writing') ? 'page' : undefined}>写作</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>关于</a>
      </nav>
      <div class="header-actions">
        <a class="icon-button" href="/search/" aria-label="搜索文章"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg></a>
        <button class="icon-button theme-toggle" type="button" aria-label="切换到深色主题"><svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="12" cy="12" r="8"/><path d="M12 4a8 8 0 0 1 0 16Z" fill="currentColor"/></svg></button>
      </div>
    </header>
    <main id="content"><slot /></main>
    <footer class="site-footer" data-pagefind-ignore>
      <a href="/" class="footer-name">Heggria<span>上海 · OpenDesign</span></a>
      <div><a href="https://github.com/heggria">GitHub</a><a href="/rss.xml">RSS</a><a href="mailto:bshengtao@gmail.com">Email</a></div>
      <span class="copyright">2022–{new Date().getFullYear()}</span>
    </footer>
    <script>
      const button = document.querySelector<HTMLButtonElement>('.theme-toggle')
      const media = matchMedia('(prefers-color-scheme: dark)')
      function label() { button?.setAttribute('aria-label', document.documentElement.dataset.theme === 'dark' ? '切换到浅色主题' : '切换到深色主题') }
      label()
      button?.addEventListener('click', () => { const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'; document.documentElement.dataset.theme = next; try { localStorage.setItem('theme', next) } catch {} label() })
      media.addEventListener('change', () => { let saved; try { saved = localStorage.getItem('theme') } catch {} if (!saved) { document.documentElement.dataset.theme = media.matches ? 'dark' : 'light'; label() } })
    </script>
  </body>
</html>
