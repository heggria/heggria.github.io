---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { published, newestFirst } from '../lib/posts'
const posts = (await getCollection('posts')).filter(published).sort(newestFirst)
const projects = [
  { name: 'taskflow', kind: '个人开源', description: '给 coding agent 编排任务，查看执行记录，重放或重算其中一部分。', href: 'https://github.com/heggria/taskflow', mark: '↳', tech: 'TypeScript · Beta' },
  { name: 'OpenDesign', kind: '工作', description: '目前所在的团队，做开源、本地优先的设计工具。', href: 'https://github.com/nexu-io/open-design', mark: '◇', tech: '设计工具' },
  { name: 'SelfField', kind: '个人实验', description: '记录经历和相互矛盾的想法，不给自己归一个人格类型。', href: 'https://heggria.github.io/selffield/', mark: '◎', tech: 'React' },
]
---
<BaseLayout>
  <div class="page-width">
    <section class="home-intro">
      <div class="intro-main"><p class="eyebrow">个人网站 / NOTES SINCE 2022</p><h1>Heggria<span class="accent">.</span></h1><p class="intro-description">在上海写代码，<br>目前在 <a href="https://github.com/nexu-io/open-design">OpenDesign</a>。</p><p class="intro-note">这里放我做的项目，以及从 2022 年开始写的技术笔记。</p></div>
      <aside class="intro-aside"><div class="portrait-frame"><img src="/avatar.jpg" alt="Heggria 的头像" width="208" height="208" fetchpriority="high"/><span class="portrait-caption">HEGGRIA / SHANGHAI</span></div><a class="text-link" href="/about/">多了解一点 ↗</a></aside>
    </section>
    <section class="home-projects" id="work" aria-labelledby="work-title">
      <div class="section-label"><h2 id="work-title">最近在做</h2><a href="/work/">所有项目 ↗</a></div>
      <div class="project-trio">{projects.map(p=><a class="project-tile" href={p.href}><span class="project-top"><span class="project-symbol" aria-hidden="true">{p.mark}</span><span>{p.kind}</span><span class="external-arrow" aria-hidden="true">↗</span></span><h3>{p.name}</h3><p>{p.description}</p><span class="project-tech">{p.tech}</span></a>)}</div>
    </section>
    <section class="home-writing" aria-labelledby="writing-title">
      <div class="section-label"><h2 id="writing-title">最近的文章 <span class="count">{posts.length}</span></h2><a href="/writing/">全部文章 ↗</a></div>
      <div>{posts.slice(0,6).map(post=><PostCard post={post} />)}</div>
      <a class="archive-link" href="/writing/">往前翻翻 <span>2022 — {new Date().getFullYear()} ↗</span></a>
    </section>
    <section class="home-contact"><p>想交流某个项目或文章？</p><a href="mailto:bshengtao@gmail.com">给我写邮件 ↗</a></section>
  </div>
</BaseLayout>
