---
import { getCollection, render, type CollectionEntry } from 'astro:content'
import PostLayout from '../../layouts/PostLayout.astro'
import FlowLab from '../../components/FlowLab.astro'
import { published, readingMinutes } from '../../lib/posts'
export async function getStaticPaths() {
  const posts = (await getCollection('posts')).filter(published)
  return posts.map(post=>({params:{id:post.id},props:{post}}))
}
interface Props { post: CollectionEntry<'posts'> }
const { post }=Astro.props
const { Content, headings }=await render(post)
const canonical=new URL(`/writing/${post.id}/`,Astro.site).href
---
<PostLayout title={post.data.title} description={post.data.description} date={post.data.date} minutes={readingMinutes(post.body)} tags={post.data.tags} canonical={canonical} headings={headings}>
  {post.id === 'recompute-case-study' && <div slot="exhibit" class="article-experiment"><FlowLab id="article-flow" /></div>}
  <Content />
</PostLayout>
