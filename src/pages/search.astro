---
import BaseLayout from '../layouts/BaseLayout.astro'
---
<BaseLayout title="搜索 — Heggria" description="搜索文章正文、标题和代码。">
  <div class="page-width search-page"><header class="page-heading"><p class="eyebrow">SEARCH</p><h1>找一篇文章<span class="accent">.</span></h1></header><label class="search-label" for="search">搜索标题和正文</label><input id="search" class="search-box" type="search" placeholder="比如：taskflow、响应式、npm…" autocomplete="off"/><p id="search-status" role="status">输入关键词开始搜索。</p><div id="search-results"></div><noscript><p>全文搜索需要 JavaScript。你也可以<a href="/writing/">按年份浏览全部文章</a>。</p></noscript></div>
  <script is:inline>
    const input=document.querySelector('#search'),status=document.querySelector('#search-status'),results=document.querySelector('#search-results');let pagefind,sequence=0,timer;
    input.addEventListener('input',()=>{clearTimeout(timer);const id=++sequence,query=input.value.trim();results.replaceChildren();if(!query){status.textContent='输入关键词开始搜索。';return}status.textContent='搜索中…';timer=setTimeout(async()=>{try{pagefind ||= import('/pagefind/pagefind.js');const engine=await pagefind;const search=await engine.search(query);const data=await Promise.all(search.results.slice(0,20).map(r=>r.data()));if(id!==sequence)return;status.textContent=search.results.length?`找到 ${search.results.length} 篇文章${search.results.length>20?'，先显示前 20 篇':''}`:'没有找到匹配的文章，换个关键词试试。';results.replaceChildren(...data.map(item=>{const a=document.createElement('a');a.className='search-result';a.href=item.url;const h=document.createElement('h2');h.textContent=item.meta.title;const p=document.createElement('p');p.innerHTML=item.excerpt;a.append(h,p);return a}))}catch{if(id!==sequence)return;pagefind=undefined;status.textContent='搜索暂时不可用，可以前往文章列表浏览。';const a=document.createElement('a');a.href='/writing/';a.textContent='打开文章列表 →';results.replaceChildren(a)}},160)})
  </script>
</BaseLayout>
